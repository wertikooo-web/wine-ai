{
  "name": "wine-ai-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Independent realtime voice lab for a Moldovan wine digital expert, built on a reusable realtime core.",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/knowledge-republish.js && node scripts/knowledge-index.js && node scripts/knowledge-embed-backfill.js",
    "knowledge:republish": "node scripts/knowledge-republish.js",
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "knowledge:index": "node scripts/knowledge-index.js",
    "knowledge:check": "node scripts/knowledge-check.js",
    "knowledge:update": "node scripts/knowledge-update.js",
    "knowledge:embed-backfill": "node scripts/knowledge-embed-backfill.js",
    "test": "node scripts/run-tests.js",
    "test:smoke": "node scripts/run-smoke.js",
    "smoke:http": "node scripts/http-smoke.js",
    "smoke:realtime": "node scripts/realtime-smoke.js",
    "smoke:language": "node scripts/language-smoke.js",
    "smoke:knowledge": "node scripts/knowledge-smoke.js",
    "check:missing-imports": "node scripts/check-missing-local-imports.js",
    "lint": "node --check src/server.js",
    "typecheck": "echo \"no build-time typecheck configured (JS + JSDoc project); see AGENTS.md\"",
    "avatar:validate": "npm run avatar:validate:manifest && npm run avatar:validate:events && npm run avatar:validate:assets",
    "avatar:validate:manifest": "node .claude/skills/winemd-rive/scripts/validate-rive-manifest.mjs",
    "avatar:validate:events": "node .claude/skills/winemd-rive/scripts/validate-visual-events.mjs",
    "avatar:validate:assets": "node .claude/skills/winemd-rive/scripts/validate-character-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@google/genai": "^2.11.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "^149.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.3.0",
    "three": "^0.184.0",
    "ws": "^8.21.1"
  }
}
