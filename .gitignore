node_modules/
.env
*.log
knowledge/index/*.json
!knowledge/index/.gitkeep
# Local file-based fallback for the discovered-docs store (prod uses Postgres
# via DATABASE_URL) вЂ” this is throwaway local dev/test state, not source data.
knowledge/discovered/*.json
# Same reasoning for the local persona-overrides fallback (prod uses
# Postgres вЂ” see src/persona/personaStore.js).
data/persona-overrides.json
# Source PDFs for the wine-book knowledge extraction (raw books, not app
# code/assets) and other large local-only media вЂ” never part of the deploy.
/DATABASE WINE ALL/
*.mp4
*.pptx
*.docx
*.pdf
# LocalFileStorageAdapter's default write target (src/kos/storage/objectStorage.js)
# вЂ” generated local dev/test data, not source.
knowledge/raw_objects/
# Crawler runtime output вЂ” must go to Postgres, not Git.
# These paths are generated by crawlIngestionService and must NOT be committed.
knowledge/source/discovered-*.md
# Entity facts runtime store вЂ” migrated to Postgres (entity_facts table).
# Keep curated fixtures only.
knowledge/entity-facts/*.json
!knowledge/entity-facts/.gitkeep
# Large binary assets вЂ” never commit to Git, use object storage instead.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.riv
*.woff
*.woff2
*.ttf
*.otf
# Local dev scripts for production operations
scripts/run-data-migration.js
scripts/run-schema-migration.js
scripts/fix-schema-checksums.js
scripts/check-storage.js
scripts/verify-production.js
prod_logs_raw.txt
scratch_grok_debug*.txt
grokTestOut*.txt
rotationRaceTestOutput.txt
experiments/adaptive-routing/smoke-results.json
experiments/adaptive-routing/*-results.json
experiments/adaptive-routing/results*.json
experiments/adaptive-routing/ab-b*.json
experiments/adaptive-routing/fx-b*.json
experiments/adaptive-routing/smoke-batch*.json
