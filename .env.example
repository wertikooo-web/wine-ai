PORT=3200
REALTIME_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
VOICE_ID=Kore

# Classic cloud pipeline: Whisper STT -> Gemini text/RAG/tools -> language-aware TTS.
# Whisper is the default because the proven Lunara Toy implementation is reused.
OPENAI_API_KEY=
CLASSIC_STT_PROVIDER=whisper
CLASSIC_STT_MODEL=whisper-1
CLASSIC_MIN_STT_PCM_BYTES=6000
CLASSIC_WHISPER_PROMPT=

# Optional alternative STT. Not required for the first Classic launch.
DEEPGRAM_API_KEY=
CLASSIC_DEEPGRAM_MODEL=nova-3

CLASSIC_LLM_MODEL=gemini-3.1-flash-lite
CLASSIC_TTS_MODEL=gemini-3.1-flash-tts-preview
CLASSIC_TTS_VOICE=Kore
CLASSIC_MAX_INPUT_BYTES=8388608
CLASSIC_MAX_TOOL_ROUNDS=4

# Russian Classic TTS follows the proven Lunara Toy route: Yandex SpeechKit.
# Romanian and English use Gemini TTS. If Yandex is unavailable, Russian falls back to Gemini.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
CLASSIC_YANDEX_VOICE_RU=alena
CLASSIC_YANDEX_SPEED=0.9

# Vision OCR for scanned PDFs (uses Gemini Vision API)
GEMINI_VISION_MODEL=gemini-2.0-flash

# Grok Voice / xAI. GROK_API_KEY is preferred; XAI_API_KEY is also supported.
GROK_API_KEY=
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE_ID=rex
GROK_REALTIME_URL=wss://api.x.ai/v1/realtime

# Push-to-talk silence tail (see docs/ARCHITECTURE.md) — matches the proven
# lunara-realtime value; only change with a measured reason.
PTT_SILENCE_TAIL_MS=300
PTT_TURN_TIMEOUT_MS=4500
# Free Conversation only: speech-activity watchdog, NOT a cap on utterance
# length. Only a frame that clears the no-speech amplitude threshold re-arms
# it -- silent frames (streamed continuously between/after words, same as
# during the incident) do NOT. It fires if genuine speech activity stops for
# this long AND no input_audio.end/native-stop signal ever closed the turn (a
# lost stop signal), forcing the hung turn closed so the session doesn't get
# stuck ignoring speech. A genuinely long utterance (as long as the user
# keeps actually talking) never trips it. See the 2026-08-17
# false-barge-in-then-hung-turn incident.
FREE_CONV_INPUT_HANG_TIMEOUT_MS=12000

# Mock provider (no API key needed) — used when REALTIME_PROVIDER=mock.
MOCK_PROCESSING_DELAY_MS=650
MOCK_CHUNK_INTERVAL_MS=220
MOCK_CHUNK_DURATION_MS=260
MOCK_CHUNK_COUNT=8
MOCK_SAMPLE_RATE=16000
MOCK_TONE_HZ=440

# Avatar
AVATAR_PROVIDER=mock
AVATAR_API_KEY=

# Knowledge base
KNOWLEDGE_STORE=local
KNOWLEDGE_PATH=./knowledge

# Discovered-documents queue (src/knowledge/discovered/store.js): falls
# back to knowledge/discovered/*.json when unset. On Railway this is set
# automatically as a reference to the attached Postgres addon
# (${{Postgres.DATABASE_URL}}) - never paste a real connection string here.
DATABASE_URL=

DEFAULT_LANGUAGE=auto
LOG_LEVEL=info

# Off by default. Turning this on stores raw session audio to disk for
# debugging — never enable without explicit user consent.
SAVE_AUDIO=false

# WINE AI KOS object storage. Keep 'local' for local development; switching a
# deployed environment is a separate, explicit operation.
KOS_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_OBJECT_PREFIX=
S3_SIGNED_URL_TTL_SECONDS=3600
# Browser-rendered local 3D avatar. Disabled by default when NODE_ENV=production.
AVATAR_3D_ENABLED=false
# Keep the standalone avatar lab local unless explicitly enabled in production.
AVATAR_DEV_PANEL=false
